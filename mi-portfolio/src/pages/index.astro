---
// src/pages/index.astro
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sitio en Construcción | Gaspar Puente</title>
  </head>
  <body class="min-h-screen bg-neutral-950 text-neutral-100 flex items-center justify-center p-6 relative overflow-hidden selection:bg-indigo-500 selection:text-white">
    
    <!-- Efecto de luz de fondo (Glow) -->
    <div class="absolute -top-40 -left-40 w-96 h-96 bg-indigo-500/20 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-emerald-500/10 rounded-full blur-[120px] pointer-events-none"></div>

    <main class="w-full max-w-lg relative z-10">
      <div class="p-8 md:p-10 rounded-2xl bg-neutral-900/60 border border-neutral-800/80 backdrop-blur-xl shadow-2xl text-center space-y-6">
        
        <!-- Badge de estado -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          En desarrollo
        </div>

        <!-- Títulos -->
        <div class="space-y-2">
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight bg-gradient-to-r from-neutral-100 via-neutral-200 to-neutral-400 bg-clip-text text-transparent">
            Sitio en Construcción
          </h1>
          <p class="text-sm text-neutral-400 leading-relaxed">
            Estoy rediseñando mi portfolio profesional. Pronto estará disponible con mis proyectos recientes y stack tecnológico.
          </p>
        </div>

        <!-- Barra de progreso simulada -->
        <div class="space-y-2 text-left">
          <div class="flex justify-between text-xs font-mono text-neutral-400">
            <span>Progreso</span>
            <span class="text-indigo-400">Building...</span>
          </div>
          <div class="w-full h-1.5 bg-neutral-800 rounded-full overflow-hidden">
            <div class="w-3/5 h-full bg-gradient-to-r from-indigo-500 to-emerald-400 rounded-full"></div>
          </div>
        </div>

        <!-- Enlaces a redes / contacto -->
        <div class="pt-4 border-t border-neutral-800/60 flex items-center justify-center gap-4">
          <a
            href="https://github.com/gasparpuentevillarroel"
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 text-xs font-medium rounded-lg bg-neutral-800 hover:bg-neutral-700 text-neutral-200 transition-colors duration-200 border border-neutral-700/50"
          >
            GitHub
          </a>
          <a
            href="https://linkedin.com"
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 text-xs font-medium rounded-lg bg-neutral-800 hover:bg-neutral-700 text-neutral-200 transition-colors duration-200 border border-neutral-700/50"
          >
            LinkedIn
          </a>
        </div>

      </div>
    </main>

  </body>
</html>
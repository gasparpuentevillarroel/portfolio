---
import Button from './Button.astro';

interface Props {
  email?: string;
  linkedinUrl?: string;
}

const {
  email = "gasparpuentevillarroel2006@gmail.com",
  linkedinUrl = "https://www.linkedin.com/in/gaspar-puente-villarroel-5043a8303",
} = Astro.props;

// Separamos el string en un array de palabras automáticamente
const headlineWords = "Hablemos sobre nuevas ideas o proyectos.".split(" ");
---

<div class="contact-card">
  <div class="contact-content">
    
    <!-- Título animado por palabra -->
    <h3 class="headline headline-reveal">
      {headlineWords.map((word, index) => (
        <span class="word-wrapper">
          <span class="word" style={`transition-delay: ${index * 0.12}s;`}>{word}</span>
        </span>
      ))}
    </h3>
    
    <p class="description">
      Disponible para colaboraciones, desarrollo de software o charlar sobre arquitectura e ingeniería web.
    </p>

    <div class="contact-actions">
      <!-- 1. Botón Copiar correo -->
      <Button
        text="Copiar correo"
        variant="outline"
        copyText={email}
        class="btn-contact-outline"
      >
        <svg slot="icon-left" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
          <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
        </svg>
      </Button>

      <!-- 2. Botón LinkedIn -->
      <Button
        text="LinkedIn"
        variant="ochre"
        href={linkedinUrl}
        target="_blank"
      >
        <svg slot="icon-left" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
          <rect width="4" height="12" x="2" y="9"/>
          <circle cx="4" cy="4" r="2"/>
        </svg>
      </Button>
    </div>
  </div>
</div>

<script>
  // Observador para activar la animación del título al entrar en pantalla
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target); 
      }
    });
  }, { 
    threshold: 0.4, 
    rootMargin: '0px 0px -20px 0px' 
  });

  const headlineReveal = document.querySelector('.contact-card .headline-reveal');
  if (headlineReveal) {
    observer.observe(headlineReveal);
  }
</script>

<style>
  .contact-card {
    width: 100%;
    max-width: 680px;
    background-color: var(--accent-slate, #344c5c);
    border-radius: 28px;
    padding: clamp(2rem, 4vw, 3.5rem);
    box-sizing: border-box;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.15);
  }

  .contact-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .tag {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-ochre, #c98a2c);
  }

  /* =========================================
     ANIMACIÓN DEL TÍTULO (SLIDE UP BY WORD)
     ========================================= */
  .headline {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #fbf7f0;
    margin: 0;
    
    /* Display flex para que las palabras respeten el espaciado y se acomoden */
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.28em; 
    row-gap: 0.1em;
  }

  .word-wrapper {
    display: inline-block;
    overflow: hidden;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em; 
  }

  .word {
    display: inline-block;
    transform: translateY(110%);
    /* Misma curva de aceleración suave */
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Estado activado por JS */
  .headline-reveal.is-visible .word {
    transform: translateY(0);
  }
  /* ========================================= */

  .description {
    font-size: 1.05rem;
    line-height: 1.6;
    color: #dbe2e8;
    margin: 0;
  }

  .contact-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }

  /* Ajuste de contraste para la variante outline sobre el fondo oscuro pizarra */
  :global(.btn-contact-outline) {
    border-color: rgba(251, 247, 240, 0.35) !important;
    color: #fbf7f0 !important;
  }

  :global(.btn-contact-outline:hover) {
    background-color: rgba(251, 247, 240, 0.1) !important;
    border-color: #fbf7f0 !important;
  }

  :global(.btn-contact-outline.copied) {
    border-color: #8be090 !important;
    color: #8be090 !important;
  }

  @media (max-width: 600px) {
    .contact-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
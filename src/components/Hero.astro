<section id="hero">
  <div class="hero-content">
    <h1 class="title">
      <!-- Letra G (Bordó) y su pelota -->
      <span class="char-wrapper">
        <span class="ball color-wine-bg"></span>
        <span class="char g color-wine">G</span>
      </span>
      <!-- Letra a (Pizarra) -->
      <span class="char a color-slate">a</span>
      <!-- Letra s (Rojo) -->
      <span class="char s color-red">s</span>
      <!-- Letra p (Ocre) -->
      <span class="char p color-ochre">p</span>
      <!-- Letra o (Verde) -->
      <span class="container initial"><span class="box shape-o"></span></span>
    </h1>
    <p class="subtitle">Ingeniero en Sistemas</p>
  </div>
</section>

<script>
  import { gsap } from "gsap";

  document.addEventListener("DOMContentLoaded", () => {
    const tl = gsap.timeline();

    gsap.set([".char", ".ball", ".initial"], { visibility: "visible", opacity: 0 });
    gsap.set(".char.g", { opacity: 0 });

    tl.fromTo(".ball", 
      { x: "-50vw", y: -400, scaleX: 0.4, scaleY: 2.2, rotation: -90, opacity: 1 },
      { x: 0, y: 0, scaleX: 0.7, scaleY: 1.3, rotation: 0, duration: 0.7, ease: "power3.in" }
    )
    .to(".ball", { scaleX: 2.3, scaleY: 0.25, duration: 0.12, ease: "power4.out" })
    .to(".ball", { scaleX: 0.8, scaleY: 1.3, duration: 0.15, ease: "power2.out" })
    .to(".ball", { scaleX: 1.15, scaleY: 0.85, duration: 0.12, ease: "power2.out" })
    .to(".ball", { scaleX: 1, scaleY: 1, duration: 0.18, ease: "back.out(2)" })
    .to(".ball", { opacity: 0, scale: 1.1, filter: "blur(6px)", duration: 0.28, ease: "power2.out" })
    .fromTo(".char.g", 
      { scale: 0.85, opacity: 0, filter: "blur(4px)" }, 
      { scale: 1, opacity: 1, filter: "blur(0px)", duration: 0.01, ease: "power3.out" },
      "-=0.22"
    )
    .fromTo(".char.a",
      { y: -150, opacity: 0 },
      { y: 0, opacity: 1, duration: 1, ease: "elastic.out(1, 0.3)" },
      "-=0.2"
    )
    .fromTo(".char.s",
      { rotateX: -90, y: 50, opacity: 0 },
      { rotateX: 0, y: 0, opacity: 1, duration: 0.6, ease: "back.out(1.5)" },
      "-=0.7"
    )
    .fromTo(".char.p",
      { rotateZ: -45, transformOrigin: "bottom left", opacity: 0 },
      { rotateZ: 0, opacity: 1, duration: 0.6, ease: "back.out(2)" },
      "-=0.5"
    )
    .fromTo(".initial",
      { scale: 0, opacity: 0 },
      { scale: 1, opacity: 1, duration: 0.5, ease: "back.out(1.5)" },
      "-=0.4"
    )
    .to(".subtitle", { 
      opacity: 1, 
      y: 0, 
      duration: 0.8, 
      ease: "power2.out",
      onComplete: () => {
        window.dispatchEvent(new Event("introTerminada"));
      }
    }, "-=0.2");
  });
</script>


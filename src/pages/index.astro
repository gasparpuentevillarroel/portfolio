---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Proyectos from '../components/Proyectos.astro';
import SobreMi from '../components/SobreMiTemp.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Gaspo | Portfolio">
  <main class="main-wrapper">
    <Hero />
    <SobreMi />
    <Proyectos />
    <Contacto />
    <Footer />
  </main>
</Layout>

<style>
  .main-wrapper {
    width: 100%;
    overflow-x: hidden;
    position: relative;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  let animCtx: gsap.Context;
  let windowWidth = window.innerWidth;

  // Método 2: Cálculo dinámico de delta centro a centro y escala
  const getTargetMetrics = (targetSelector: string) => {
    const origin = document.querySelector(".container.initial");
    const target = document.querySelector(targetSelector);
    if (!origin || !target) return { x: 0, y: 0, scale: 1 };

    const originRect = origin.getBoundingClientRect();
    const targetRect = target.getBoundingClientRect();

    // Centros absolutos respecto al viewport actual
    const originCenterX = originRect.left + originRect.width / 2;
    const originCenterY = originRect.top + originRect.height / 2;

    const targetCenterX = targetRect.left + targetRect.width / 2;
    const targetCenterY = targetRect.top + targetRect.height / 2;

    return {
      x: targetCenterX - originCenterX,
      y: targetCenterY - originCenterY,
      scale: targetRect.width / originRect.width,
    };
  };

  const initAnimations = () => {
    if (animCtx) animCtx.revert();

    animCtx = gsap.context(() => {
      // Punto de anclaje de rotación y escala al centro
      gsap.set(".box", { transformOrigin: "center center" });

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: "#hero",
          start: "top top",
          endTrigger: "#contact",
          end: "bottom bottom",
          scrub: 0.6,
          invalidateOnRefresh: true, // Recalcula las funciones flecha en cada resize
        },
      });

      // PARADA 1: Viaje hacia "Sobre mí" -> Cuadrado redondeado
      tl.to(".box", {
        x: () => getTargetMetrics(".second .marker").x,
        y: () => getTargetMetrics(".second .marker").y,
        scale: () => getTargetMetrics(".second .marker").scale,
        borderColor: "#c98a2c",
        backgroundColor: "#c98a2c",
        borderWidth: "0px",
        borderRadius: "25%",
        rotation: 90,
        duration: 1.2,
        ease: "power1.inOut",
      })
      // Pausa de lectura en Sobre Mí
      .to({}, { duration: 0.6 })

      // PARADA 2: Viaje hacia "Proyectos" -> Rombo afilado
      .to(".box", {
        x: () => getTargetMetrics(".third .marker").x,
        y: () => getTargetMetrics(".third .marker").y,
        scale: () => getTargetMetrics(".third .marker").scale,
        backgroundColor: "#faf18b",
        borderRadius: "0%",
        rotation: 45,
        duration: 1.2,
        ease: "power1.inOut",
      })
      // Pausa de exploración en Proyectos
      .to({}, { duration: 1 })

      // PARADA 3: Viaje hacia "Contacto" -> Círculo sólido
      .to(".box", {
        x: () => getTargetMetrics(".fourth .marker").x,
        y: () => getTargetMetrics(".fourth .marker").y,
        scale: () => getTargetMetrics(".fourth .marker").scale,
        backgroundColor: "#344c5c",
        borderRadius: "50%",
        rotation: 0,
        duration: 1.2,
        ease: "power1.inOut",
      });
    });
  };

  // Inicialización tras finalizar la intro
  window.addEventListener("introTerminada", () => {
    document.fonts.ready.then(() => {
      ScrollTrigger.refresh();
      initAnimations();
    });
  });

  // Recálculo ante cambios de ancho (rotación de pantalla o resize)
  let resizeTimer: ReturnType<typeof setTimeout>;
  window.addEventListener("resize", () => {
    if (window.innerWidth !== windowWidth) {
      windowWidth = window.innerWidth;
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        initAnimations();
        ScrollTrigger.refresh();
      }, 150);
    }
  });
</script>